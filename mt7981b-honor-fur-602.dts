// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
//
// HONOR FUR-602 / FUR-603  (a.k.a. 荣耀 XU50 / XT50 / XC50, 联通定制版)
//   SoC   : MediaTek MT7981B (Filogic 820)
//   RAM   : 256 MiB DDR3
//   Flash : 128 MiB SPI-NAND, NMBM enabled
//   WLAN  : MT7981 2.4G 2x2 + MT7976CN 5G 2x2  = AX3000
//   ETH   : MT7531 switch, 1x 1G WAN + 3x 1G LAN, all behind gmac0
//
// ---------------------------------------------------------------------------
//  ImmortalWrt 25.12 variant (kernel 6.12) - CLOSED-SOURCE MTK WiFi (mt_wifi)
// ---------------------------------------------------------------------------
//  Baseline: chasey-dev/immortalwrt-mt798x-rebase @ branch 25.12
//            target/linux/mediatek, subtarget filogic, KERNEL_PATCHVER 6.12
//
//  This is the closed-source (MTK mt_wifi) counterpart of schema12's
//  open-source (mt76) device tree. The DTS must live in dts-ext/ and be
//  referenced by filogic-ext.mk with DEVICE_DTS_DIR := ../dts-ext.
//
//  Differences from the open-source variant:
//   1. WiFi EEPROM binding: nvmem-cells -> eeprom_factory_0 instead of the
//      mediatek,mtd-eeprom spelling. This is the convention used by every
//      closed-source device in the chasey tree (cf. cmcc-xr30-nand-mtkuboot,
//      cudy-tr3000-v1-mtkuboot, xiaomi-mi-router-ax3000t-mtkuboot).
//   2. 5G band MAC: band@1 consumes factory@0xa (mac-base), the MT7981
//      convention in closed-source trees; gmac0 keeps factory@0x2a and the
//      WAN switch port keeps factory@0x24 (verified against the open-source
//      25.12 device tree).
//
//  The three kernel-6.12 adaptations carried over from the open-source file:
//   1. #include "mt7981b.dtsi" instead of "mt7981.dtsi".
//   2. <dt-bindings/pinctrl/mt65xx.h> included explicitly.
//   3. memory node written as memory@40000000 with device_type = "memory".
//
//  Boot chain: unchanged. The bl-mt798x U-Boot boots the FIT out of the UBI
//  volume named "kernel" (KERNEL_IN_UBI=1), and platform.sh still routes an
//  unlisted board through the generic `nand_do_upgrade "$1"` fallback with
//  nand.sh's default CI_KERNPART=kernel / CI_ROOTPART=rootfs.
//
// Hardware facts cross-checked against:
//   1. hanwckf/bl-mt798x (mt7981_honor_fur-602 U-Boot, expand(114m) layout):
//      bl2|u-boot-env|factory|Trace|fip|ubi(116736k)
//   2. hanwckf/immortalwrt-mt798x @ openwrt-21.02: authoritative port wiring,
//      NMBM overlay, SPI calibration data.
//   3. schema12/honor-fur_602 @ migration/immortalwrt-25.12.2: the verified
//      6.12 adaptations above.
//
// Requires the hanwckf/bl-mt798x "mt7981_honor_fur-602" U-Boot (20241115 or
// the 20230718 build it is derived from) with the expand(114m) mtd layout.
// The stock HONOR U-Boot is signature-locked and cannot boot this firmware.
//
/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/mt65xx.h>

#include "mt7981b.dtsi"

/ {
	model = "HONOR FUR-602/603";
	compatible = "honor,fur-602", "mediatek,mt7981";

	aliases {
		serial0 = &uart0;
		label-mac-device = &gmac0;
		led-boot = &led_status_red;
		led-failsafe = &led_status_red;
		led-running = &led_status_green;
		led-upgrade = &led_status_green;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x10000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
		};

		button-mesh {
			label = "mesh";
			linux,code = <BTN_9>;
			linux,input-type = <EV_SW>;
			gpios = <&pio 0 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status_green: green {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pio 8 GPIO_ACTIVE_LOW>;
		};

		led_status_red: red {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&pio 13 GPIO_ACTIVE_LOW>;
		};
	};
};

&eth {
	status = "okay";

	gmac0: mac@0 {
		compatible = "mediatek,eth-mac";
		reg = <0>;
		phy-mode = "2500base-x";

		nvmem-cells = <&macaddr_factory_2a>;
		nvmem-cell-names = "mac-address";

		fixed-link {
			speed = <2500>;
			full-duplex;
			pause;
		};
	};
};

&mdio_bus {
	switch: switch@1f {
		compatible = "mediatek,mt7531";
		reg = <31>;
		reset-gpios = <&pio 39 GPIO_ACTIVE_HIGH>;
		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-parent = <&pio>;
		interrupts = <38 IRQ_TYPE_LEVEL_HIGH>;
	};
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_flash_pins>;
	status = "okay";

	spi_nand: spi_nand@0 {
		compatible = "spi-nand";
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0>;

		spi-max-frequency = <52000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;

		/*
		 * NMBM: matches CONFIG_ENABLE_NAND_NMBM=y in the bl-mt798x
		 * mt7981_honor_fur-602 U-Boot, which maps the whole chip through
		 * its own bad-block table. The BMT area is carved out of the
		 * top of the device, so the partitions below are the *free*
		 * area and must stay in sync with the U-Boot mtd-layout
		 * "expand(114m)" mtdparts string.
		 *
		 * Verified still supported on the 25.12 baseline: mtk_bmt.c
		 * (target/linux/generic/files/drivers/mtd/nand/) handles
		 * "mediatek,nmbm" -> mtk_bmt_nmbm_ops, and filogic/config-6.12
		 * carries CONFIG_MTD_NAND_MTK_BMT=y.
		 */
		mediatek,nmbm;
		mediatek,bmt-max-ratio = <1>;
		mediatek,bmt-max-reserved-blocks = <64>;

		/*
		 * SPI calibration data, taken verbatim from the hanwckf
		 * reference DTS for this board. Without it the SPI-NAND
		 * controller may sample at the wrong delay on this PCB.
		 */
		spi-cal-enable;
		spi-cal-mode = "read-data";
		spi-cal-datalen = <7>;
		spi-cal-data = /bits/ 8 <0x53 0x50 0x49 0x4E 0x41 0x4E 0x44>; /* 'SPINAND' */
		spi-cal-addrlen = <5>;
		spi-cal-addr = /bits/ 32 <0x0 0x0 0x0 0x0 0x0>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bl2";
				reg = <0x0000000 0x0100000>;
				read-only;
			};

			partition@100000 {
				label = "u-boot-env";
				reg = <0x0100000 0x0080000>;
			};

			factory: partition@180000 {
				label = "factory";
				reg = <0x0180000 0x01e0000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x1000>;
					};

					macaddr_factory_a: macaddr@a {
						compatible = "mac-base";
						reg = <0xa 0x6>;
					};

					macaddr_factory_24: macaddr@24 {
						reg = <0x24 0x6>;
					};

					macaddr_factory_2a: macaddr@2a {
						reg = <0x2a 0x6>;
					};
				};
			};

			partition@360000 {
				label = "trace";
				reg = <0x0360000 0x0020000>;
				read-only;
			};

			partition@380000 {
				label = "fip";
				reg = <0x0380000 0x0200000>;
				read-only;
			};

			partition@580000 {
				label = "ubi";
				reg = <0x0580000 0x7200000>;
			};
		};
	};
};

&switch {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			label = "wan";
			nvmem-cells = <&macaddr_factory_24>;
			nvmem-cell-names = "mac-address";
		};

		port@1 {
			reg = <1>;
			label = "lan3";
		};

		port@2 {
			reg = <2>;
			label = "lan2";
		};

		port@3 {
			reg = <3>;
			label = "lan1";
		};

		port@6 {
			reg = <6>;
			label = "cpu";
			ethernet = <&gmac0>;
			phy-mode = "2500base-x";

			fixed-link {
				speed = <2500>;
				full-duplex;
				pause;
			};
		};
	};
};

&pio {
	spi0_flash_pins: spi0-pins {
		mux {
			function = "spi";
			groups = "spi0", "spi0_wp_hold";
		};

		conf-pu {
			pins = "SPI0_CS", "SPI0_HOLD", "SPI0_WP";
			drive-strength = <MTK_DRIVE_8mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_11>;
		};

		conf-pd {
			pins = "SPI0_CLK", "SPI0_MOSI", "SPI0_MISO";
			drive-strength = <MTK_DRIVE_8mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_11>;
		};
	};
};

&uart0 {
	status = "okay";
};

&watchdog {
	status = "okay";
};

&wifi {
	status = "okay";

	/*
	 * Closed-source (mt_wifi) EEPROM binding. The calibration blob is read
	 * from offset 0 of the "factory" partition through nvmem-cells, the
	 * convention used by every closed-source device in the chasey tree
	 * (cf. mt7981b-cmcc-xr30-nand-mtkuboot.dts). The 5G band MAC is taken
	 * from factory@0xa via a mac-base cell, matching the MT7981 closed-
	 * source convention; gmac0/WAN keep factory@0x2a / factory@0x24.
	 */
	nvmem-cells = <&eeprom_factory_0>;
	nvmem-cell-names = "eeprom";

	band@1 {
		reg = <1>;
		nvmem-cells = <&macaddr_factory_a 0>;
		nvmem-cell-names = "mac-address";
	};
};
